\newlabel{tab:5.9}{{5.9}{64}{Dense baselines (linear, single-hidden FFNN, dual-hidden FFNN) with full regression metrics and inference throughput on the 1.5M-position test set. The reference NNUE W128 H256 (174,723 parameters) attains CE 0.6303, beating the dual-hidden FFNN2 H256 at 2.9$\times $ the parameters}{table.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.8}{\ignorespaces Test cross-entropy of the base NNUE against training-set size. From this plot we can infer that a NNUE model with two hidden layers of 64 neurons does not overfit a dataset larger than 3 million positions, though accuracy can still marginally increase with a bigger dataset.}}{65}{figure.caption.32}\protected@file@percent }
\newlabel{fig:nnue-ce-vs-train-size-8}{{5.8}{65}{Test cross-entropy of the base NNUE against training-set size. From this plot we can infer that a NNUE model with two hidden layers of 64 neurons does not overfit a dataset larger than 3 million positions, though accuracy can still marginally increase with a bigger dataset}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.9}{\ignorespaces Test cross-entropy of the base NNUE against training-set size. A NNUE model with two hidden layers of 256 neurons does not overfit a dataset larger than 7 million positions.}}{65}{figure.caption.33}\protected@file@percent }
\newlabel{fig:nnue-ce-vs-train-size-9}{{5.9}{65}{Test cross-entropy of the base NNUE against training-set size. A NNUE model with two hidden layers of 256 neurons does not overfit a dataset larger than 7 million positions}{figure.caption.33}{}}
