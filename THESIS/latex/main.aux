\@writefile{lot}{\contentsline {table}{\numberline {5.13}{\ignorespaces Oracle upper bound on the gradient-clustered experts, on the 50,000-position subsample. "Dispatcher CE" is the realised MLP-routed MoE; "Nearest-centroid CE" is the cosine/nearest-centroid routing rule of Section 5.3.3; "Oracle CE" is the true $\arg \min _k \mathcal  {L}_k$ routing. The oracle uses the target at inference and is an unachievable upper bound.}}{69}{table.caption.38}\protected@file@percent }
\newlabel{tab:5.13}{{5.13}{69}{Oracle upper bound on the gradient-clustered experts, on the 50,000-position subsample. "Dispatcher CE" is the realised MLP-routed MoE; "Nearest-centroid CE" is the cosine/nearest-centroid routing rule of Section 5.3.3; "Oracle CE" is the true $\arg \min _k \mathcal {L}_k$ routing. The oracle uses the target at inference and is an unachievable upper bound}{table.caption.38}{}}
