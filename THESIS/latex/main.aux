\@writefile{lot}{\contentsline {table}{\numberline {5.5}{\ignorespaces Parameter-free centroid routers (\texttt  {argmin} cosine similarity to the $k$-means centroids), scored against the Euclidean Mini-Batch $k$-Means labels on one million positions. Chance is $1/B$; the majority dummy ranges from $0.727$ ($B=2$) to $0.172$ ($B=16$) for the L1 labels.}}{58}{table.caption.24}\protected@file@percent }
\newlabel{tab:5.5}{{5.5}{58}{Parameter-free centroid routers (\texttt {argmin} cosine similarity to the $k$-means centroids), scored against the Euclidean Mini-Batch $k$-Means labels on one million positions. Chance is $1/B$; the majority dummy ranges from $0.727$ ($B=2$) to $0.172$ ($B=16$) for the L1 labels}{table.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces A parameter-free centroid router based on cosine similarity to the k-means centroids recovers the original cluster labels with high top-1 accuracy for both board features and L1 activations across B = 2–16, with L1 performing best.}}{58}{figure.caption.25}\protected@file@percent }
\newlabel{fig:accuracy-4}{{5.5}{58}{A parameter-free centroid router based on cosine similarity to the k-means centroids recovers the original cluster labels with high top-1 accuracy for both board features and L1 activations across B = 2–16, with L1 performing best}{figure.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.6}{\ignorespaces Learned L1-to-L1 dispatchers on one million positions ($90/10$ split), scored against the L1 Mini-Batch $k$-Means labels. Chance is $1/B$; the majority dummy is $0.727$, $0.542$, $0.248$, and $0.172$ for $B=2,4,8,16$ respectively.}}{59}{table.caption.26}\protected@file@percent }
\newlabel{tab:5.6}{{5.6}{59}{Learned L1-to-L1 dispatchers on one million positions ($90/10$ split), scored against the L1 Mini-Batch $k$-Means labels. Chance is $1/B$; the majority dummy is $0.727$, $0.542$, $0.248$, and $0.172$ for $B=2,4,8,16$ respectively}{table.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Learned L1-to-L1 dispatchers (especially a simple MLP) recover the L1 Mini-Batch k-means partition almost perfectly from the activations themselves, far above the chance baseline, confirming that the L1 clusters are nearly linearly separable.}}{59}{figure.caption.27}\protected@file@percent }
\newlabel{fig:accuracy-5}{{5.6}{59}{Learned L1-to-L1 dispatchers (especially a simple MLP) recover the L1 Mini-Batch k-means partition almost perfectly from the activations themselves, far above the chance baseline, confirming that the L1 clusters are nearly linearly separable}{figure.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.7}{\ignorespaces MLP dispatchers (hidden width $h$) trained to predict the gradient $k$-means buckets from L1 activations, on one million positions ($90/10$ split). Chance is $1/B$; the majority dummy is $0.560$, $0.361$, $0.184$, and $0.134$ for $B=2,4,8,16$ respectively.}}{60}{table.caption.28}\protected@file@percent }
\newlabel{tab:5.7}{{5.7}{60}{MLP dispatchers (hidden width $h$) trained to predict the gradient $k$-means buckets from L1 activations, on one million positions ($90/10$ split). Chance is $1/B$; the majority dummy is $0.560$, $0.361$, $0.184$, and $0.134$ for $B=2,4,8,16$ respectively}{table.caption.28}{}}
