\newlabel{tab:5.10}{{5.10}{68}{Dispatcher-routed hard MoE (piece-count, L1-clustered, gradient-clustered) on the 50,000-position test subsample. The reference base attains CE 0.6303 and MAE 0.1326 on this subsample. "Dispatcher Top-1" is the MLP dispatcher's accuracy against its own k-means pseudo-labels (L1 or gradient)}{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.11}{\ignorespaces End-to-end soft-gated MoE test CE (top-1 and top-2 gating), on the 50,000-position subsample. Base CE 0.6303. Gate entropy $\approx $ ln K and load variance $\approx $ 0 at every setting.}}{68}{table.caption.36}\protected@file@percent }
\newlabel{tab:5.11}{{5.11}{68}{End-to-end soft-gated MoE test CE (top-1 and top-2 gating), on the 50,000-position subsample. Base CE 0.6303. Gate entropy $\approx $ ln K and load variance $\approx $ 0 at every setting}{table.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.12}{\ignorespaces Switch (end-to-end sparse top-1) test CE vs. load-balancing weight $\alpha $, on the 50,000-position subsample. Base CE 0.6303.}}{69}{table.caption.37}\protected@file@percent }
