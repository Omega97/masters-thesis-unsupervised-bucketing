\newlabel{fig:umap-2d-gradients}{{5.3}{55}{UMAP projection of the gradient representation. The visualization highlights the contiguous nature of the gradient clusters along a single dense manifold, consistent with the high silhouette scores}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces t-SNE 3D projection of the raw board features (1688-d). Unlike the gradient space, the raw feature space exhibits a highly fragmented structure with significant overlap between regions that would otherwise require distinct evaluation heads, motivating the use of learned latent representations for routing.}}{55}{figure.caption.23}\protected@file@percent }
\newlabel{fig:tsne-3d-board}{{5.4}{55}{t-SNE 3D projection of the raw board features (1688-d). Unlike the gradient space, the raw feature space exhibits a highly fragmented structure with significant overlap between regions that would otherwise require distinct evaluation heads, motivating the use of learned latent representations for routing}{figure.caption.23}{}}
